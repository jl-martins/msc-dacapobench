@@ -0,0 +1,77 @@
+package org.apache.commons.httpclient.util;
+
+import java.util.Comparator;
+import java.util.Objects;
+import java.util.Spliterator;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import java.util.stream.Stream;
+import java.util.stream.StreamSupport;
+
+public final class StreamExtensions {
+    private StreamExtensions() {
+        // utility class
+    }
+
+    public static <T> Stream<T> takeWhile(Stream<T> stream, Predicate<? super T> predicate) {
+        Objects.requireNonNull(stream, "stream must not be null");
+        Objects.requireNonNull(predicate, "predicate must not be null");
+        Spliterator<T> source = stream.spliterator();
+        Spliterator<T> takeWhileSpliterator = new StreamExtensions.TakeWhileSpliterator<>(source, predicate);
+        return StreamSupport.stream(takeWhileSpliterator, false);
+    }
+
+    private static final class TakeWhileSpliterator<T> implements Spliterator<T>, Consumer<T> {
+        private final Spliterator<T> source;
+        private final Predicate<? super T> predicate;
+
+        private boolean taking = true;
+        private T currentElement = null;
+
+        public TakeWhileSpliterator(Spliterator<T> source, Predicate<? super T> predicate) {
+            this.source = source;
+            this.predicate = predicate;
+        }
+
+        @Override
+        public void accept(T t) {
+            this.currentElement = t;
+        }
+
+        @Override
+        public boolean tryAdvance(Consumer<? super T> action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (!taking) {
+                return false;
+            }
+
+            taking = source.tryAdvance(this) && predicate.test(currentElement);
+            if (taking) {
+                action.accept(currentElement);
+            }
+
+            currentElement = null;  // allow GC of the processed element (if any)
+            return taking;
+        }
+
+        @Override
+        public Spliterator<T> trySplit() {
+            return null;  // preserve ordered takeWhile semantics
+        }
+
+        @Override
+        public long estimateSize() {
+            return taking ? source.estimateSize() : 0;
+        }
+
+        @Override
+        public int characteristics() {
+            return source.characteristics() & (~Spliterator.SIZED | ~Spliterator.SUBSIZED);
+        }
+
+        @Override
+        public Comparator<? super T> getComparator() {
+            return source.getComparator();
+        }
+    }
+}
