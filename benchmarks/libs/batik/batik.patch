+package org.apache.batik.util;
+
+import java.util.Objects;
+import java.util.Spliterator;
+import java.util.Spliterators;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import java.util.function.UnaryOperator;
+import java.util.stream.Stream;
+import java.util.stream.StreamSupport;
+
+public final class StreamExtensions {
+
+    private StreamExtensions() {
+    }
+
+    public static <T> Stream<T> iterate(T seed, Predicate<? super T> hasNext, UnaryOperator<T> next) {
+        Objects.requireNonNull(hasNext, "hasNext must not be null");
+        Objects.requireNonNull(next, "next must not be null");
+        return StreamSupport.stream(new IterateSpliterator<>(seed, hasNext, next), false);
+    }
+
+    private static final class IterateSpliterator<T> extends Spliterators.AbstractSpliterator<T> {
+        private final T seed;
+        private final Predicate<? super T> hasNext;
+        private final UnaryOperator<T> next;
+
+        private T prev;
+        private boolean started;
