+package org.apache.kafka.common.utils;
+
+import java.util.Objects;
+import java.util.Spliterator;
+import java.util.Spliterators;
+import java.util.function.IntConsumer;
+import java.util.function.IntPredicate;
+import java.util.function.IntUnaryOperator;
+import java.util.stream.IntStream;
+import java.util.stream.StreamSupport;
+
+public final class IntStreamExtensions {
+    private IntStreamExtensions() {
+        // utility class
+    }
+
+    public static IntStream iterate(int seed, IntPredicate hasNext, IntUnaryOperator next) {
+        Objects.requireNonNull(hasNext, "hasNext must not be null");
+        Objects.requireNonNull(next, "next must not be null");
+        return StreamSupport.intStream(new IterateSpliterator(seed, hasNext, next), false);
+    }
+
+    private static final class IterateSpliterator extends Spliterators.AbstractIntSpliterator {
+        private final int seed;
+        private final IntPredicate hasNext;
+        private final IntUnaryOperator next;
+
+        private int prev;
+        private boolean started;
+        private boolean finished;
+
+        private IterateSpliterator(int seed, IntPredicate hasNext, IntUnaryOperator next) {
+            super(Long.MAX_VALUE, Spliterator.ORDERED | Spliterator.IMMUTABLE | Spliterator.NONNULL);
+            this.seed = seed;
+            this.hasNext = hasNext;
+            this.next = next;
+            this.started = false;
+            this.finished = false;
+        }
+
+
+        @Override
+        public boolean tryAdvance(IntConsumer action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (finished) {
+                return false;
+            }
+
+            int t;
+            if (started) {
+                t = next.applyAsInt(prev);
+            } else {
+                t = seed;
+                started = true;
+            }
+
+            if (!hasNext.test(t)) {
+                finished = true;
+                return false;
+            } else {
+                action.accept(t);
+                prev = t;
+                return true;
+            }
+        }
+    }
+}
