+package org.h2.util;
+
+import java.util.Comparator;
+import java.util.Objects;
+import java.util.Spliterator;
+import java.util.function.IntConsumer;
+import java.util.function.IntPredicate;
+import java.util.stream.IntStream;
+import java.util.stream.StreamSupport;
+
+public final class IntStreamExtensions {
+
+    private IntStreamExtensions() {
+    }
+
+    public static IntStream takeWhile(IntStream stream, IntPredicate predicate) {
+        Objects.requireNonNull(stream, "stream must not be null");
+        Objects.requireNonNull(predicate, "predicate must not be null");
+
+        Spliterator.OfInt source = stream.spliterator();
+        Spliterator.OfInt takeWhileSpliterator = new TakeWhileSpliterator(source, predicate);
+
+        return StreamSupport.intStream(takeWhileSpliterator, stream.isParallel()).onClose(stream::close);
+    }
+
+    private static final class TakeWhileSpliterator implements Spliterator.OfInt, IntConsumer {
+        private final Spliterator.OfInt source;
+        private final IntPredicate predicate;
+
+        private boolean taking = true;
+        private int currentElement;
+
+        public TakeWhileSpliterator(Spliterator.OfInt source, IntPredicate predicate) {
+            this.source = source;
+            this.predicate = predicate;
+        }
+
+        @Override
+        public void accept(int t) {
+            this.currentElement = t;
+        }
+
+        @Override
+        public boolean tryAdvance(IntConsumer action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (!taking) {
+                return false;
+            }
+
+            taking = source.tryAdvance(this) && predicate.test(currentElement);
+            if (taking) {
+                action.accept(currentElement);
+            }
+
+            return taking;
+        }
+
+        @Override
+        public Spliterator.OfInt trySplit() {
+            return null; // preserve ordered takeWhile semantics
+        }
+
+        @Override
+        public long estimateSize() {
+            return taking ? source.estimateSize() : 0;
+        }
+
+        @Override
+        public int characteristics() {
+            return source.characteristics() & ~(Spliterator.SIZED | Spliterator.SUBSIZED);
+        }
+
+        @Override
+        public Comparator<? super Integer> getComparator() {
+            return source.getComparator();
+        }
+
+        @Override
