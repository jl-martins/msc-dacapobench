+                () -> new OutputState(stream),
+                (state, obj) -> {
+                    if (!state.first) {
+                        state.textBuffer.append(' ');
+                    }
+
+                    state.first = false;
+                    try {
+                        formatObject(obj, state.cout, state.textBuffer);
+                    } catch (IOException e) {
+                        throw new UncheckedIOException(e);
+                    }
+                },
+                (a, b) -> {
+                    throw new UnsupportedOperationException();
+                },
+                state -> {
+                    state.textBuffer.append(']');
+                    try {
+                        PDFDocument.flushTextBuffer(state.textBuffer, state.cout);
+                    } catch (IOException e) {
+                        throw new UncheckedIOException(e);
+                    }
+                    return state;
+                }
+        ));
