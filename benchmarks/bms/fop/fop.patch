+package org.apache.fop.util;
+
+import java.util.Comparator;
+import java.util.Objects;
+import java.util.Spliterator;
+import java.util.Spliterators;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import java.util.function.UnaryOperator;
+import java.util.stream.Stream;
+import java.util.stream.StreamSupport;
+
+public final class StreamExtensions {
+
+    private StreamExtensions() {
+    }
+
+    public static <T> Stream<T> iterate(T seed, Predicate<? super T> hasNext, UnaryOperator<T> next) {
+        Objects.requireNonNull(hasNext, "hasNext must not be null");
+        Objects.requireNonNull(next, "next must not be null");
+        return StreamSupport.stream(new IterateSpliterator<>(seed, hasNext, next), false);
+    }
+
+    public static <T> Stream<T> takeWhile(Stream<T> stream, Predicate<? super T> predicate) {
+        Objects.requireNonNull(stream, "stream must not be null");
+        Objects.requireNonNull(predicate, "predicate must not be null");
+        Spliterator<T> source = stream.spliterator();
+        Spliterator<T> takeWhileSpliterator = new TakeWhileSpliterator<>(source, predicate);
+        return StreamSupport.stream(takeWhileSpliterator, stream.isParallel()).onClose(stream::close);
+    }
+
+    private static final class IterateSpliterator<T> extends Spliterators.AbstractSpliterator<T> {
+        private final T seed;
+        private final Predicate<? super T> hasNext;
+        private final UnaryOperator<T> next;
+
+        private T prev;
+        private boolean started;
+        private boolean finished;
+
+        private IterateSpliterator(T seed, Predicate<? super T> hasNext, UnaryOperator<T> next) {
+            super(Long.MAX_VALUE, Spliterator.ORDERED | Spliterator.IMMUTABLE | Spliterator.NONNULL);
+            this.seed = seed;
+            this.hasNext = hasNext;
+            this.next = next;
+            this.prev = null;
+            this.started = false;
+            this.finished = false;
+        }
+
+        @Override
+        public boolean tryAdvance(Consumer<? super T> action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (finished) {
+                return false;
+            }
+
+            T t;
+            if (started) {
+                t = next.apply(prev);
+            } else {
+                t = seed;
+                started = true;
+            }
+
+            if (!hasNext.test(t)) {
+                prev = null;
+                finished = true;
+                return false;
+            } else {
+                action.accept(t);
+                prev = t;
+                return true;
+            }
+        }
+
+        @Override
+        public void forEachRemaining(Consumer<? super T> action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (finished) {
+                return;
+            }
+
+            finished = true;
+            T t = started ? next.apply(prev) : seed;
+            prev = null;
+            while (hasNext.test(t)) {
+                action.accept(t);
+                t = next.apply(t);
+            }
+        }
+    }
+
+    private static final class TakeWhileSpliterator<T> implements Spliterator<T>, Consumer<T> {
+        private final Spliterator<T> source;
+        private final Predicate<? super T> predicate;
+
+        private boolean taking = true;
+        private T currentElement = null;
+
+        public TakeWhileSpliterator(Spliterator<T> source, Predicate<? super T> predicate) {
+            this.source = source;
+            this.predicate = predicate;
+        }
+
+        @Override
+        public void accept(T t) {
+            this.currentElement = t;
+        }
+
+        @Override
+        public boolean tryAdvance(Consumer<? super T> action) {
+            Objects.requireNonNull(action, "action must not be null");
+            if (!taking) {
+                return false;
+            }
+
+            taking = source.tryAdvance(this) && predicate.test(currentElement);
+            if (taking) {
+                action.accept(currentElement);
+            }
+
+            currentElement = null;  // allow GC of the processed element (if any)
+            return taking;
+        }
+
+        @Override
+        public Spliterator<T> trySplit() {
+            return null; // preserve ordered takeWhile semantics
+        }
+
+        @Override
+        public long estimateSize() {
+            return taking ? source.estimateSize() : 0;
+        }
+
+        @Override
+        public int characteristics() {
+            return source.characteristics() & ~(Spliterator.SIZED | Spliterator.SUBSIZED);
+        }
+
+        @Override
+        public Comparator<? super T> getComparator() {
+            return source.getComparator();
+        }
+    }
+}
